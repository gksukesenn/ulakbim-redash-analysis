{
  "collection": "publications",
  "aggregate": [
    {
      "$match": {
        "publication_year": {
          "$ne": null
        }
      }
    },
    {
      "$group": {
        "_id": "$publication_year",
        "yayin_sayisi": {
          "$sum": 1
        }
      }
    },
    {
      "$sort": [
        {
          "name": "_id",
          "direction": 1
        }
      ]
    },
    {
      "$project": {
        "_id": 0,
        "yil": "$_id",
        "yayin_sayisi": 1
      }
    }
  ]
}
