{
  "collection": "publications",
  "aggregate": [
    {
      "$match": {
        "publisher": {
          "$nin": [null, ""]
        }
      }
    },
    {
      "$group": {
        "_id": "$publisher",
        "yayin_sayisi": {
          "$sum": 1
        }
      }
    },
    {
      "$sort": [
        {
          "name": "yayin_sayisi",
          "direction": -1
        }
      ]
    },
    {
      "$limit": 10
    },
    {
      "$sort": [
        {
          "name": "yayin_sayisi",
          "direction": 1
        }
      ]
    },
    {
      "$project": {
        "_id": 0,
        "yayinci": "$_id",
        "yayin_sayisi": 1
      }
    }
  ]
}
