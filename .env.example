# Yalnız yerel geliştirme içindir; production ortamında güçlü parola kullanın.
MONGODB_ROOT_USERNAME=ulakbim_admin
MONGODB_ROOT_PASSWORD=change_this_local_password
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=ulakbim_analysis
MONGODB_COLLECTION=publications
MONGODB_AUTH_DATABASE=admin
MONGODB_URI=mongodb://ulakbim_admin:change_this_local_password@127.0.0.1:27017/?authSource=admin
MONGODB_CONNECT_TIMEOUT_MS=5000

# Redash 26.3.0 yerel kurulumu
REDASH_POSTGRES_USER=redash
REDASH_POSTGRES_PASSWORD=change_this_redash_postgres_password
REDASH_POSTGRES_DATABASE=redash
REDASH_DATABASE_URL=postgresql://redash:change_this_redash_postgres_password@redash-postgres:5432/redash
REDASH_REDIS_URL=redis://redash-redis:6379/0
REDASH_SECRET_KEY=generate_a_random_secret_key
REDASH_COOKIE_SECRET=generate_a_different_random_cookie_secret
REDASH_HOST=http://localhost:5000
REDASH_PORT=5000
